VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Bucket de Supabase Storage donde el onboarding guarda los documentos (frente/dorso/selfie/servicio).
# La columna documentos.url suele guardar solo el nombre del archivo, así que se
# resuelve contra este bucket (URL firmada si es privado, o pública si es público).
VITE_STORAGE_BUCKET=kyc