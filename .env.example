VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base pública donde se sirven los documentos de onboarding (frente/dorso/selfie/servicio).
# La columna documentos.url suele guardar solo el nombre del archivo, así que se
# construye la URL como: <VITE_STORAGE_BASE_URL>/<legajo>/<archivo>
# Si no se define, se usa por defecto https://storage.molipay.com/docs
VITE_STORAGE_BASE_URL=https://storage.molipay.com/docs